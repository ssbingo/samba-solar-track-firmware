<html lang="de"><head><meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Samba Solar Track â€“ WLAN einrichten</title>
<style>
body{margin:0;background:#12161f;color:#fff;font:17px/1.5 system-ui,sans-serif}
main{max-width:460px;margin:0 auto;padding:22px 18px}
h1{font-size:23px;margin:0 0 4px}
p{color:#aab3c5;margin:6px 0 16px}
label{display:block;margin:14px 0 4px;font-weight:600}
input[type=text],input[type=password]{width:100%;box-sizing:border-box;padding:11px;border-radius:9px;
border:1px solid #3a4560;background:#1e2538;color:#fff;font-size:17px}
.row{display:flex;align-items:center;gap:8px;margin-top:10px;color:#aab3c5}
button{margin-top:22px;width:100%;padding:13px;border:0;border-radius:10px;background:#27ae60;color:#fff;
font-size:18px;font-weight:700}
#msg{margin-top:14px;color:#ffcc00;min-height:1.5em}
small{color:#8a93a6}
</style></head><body><main>
<h1>Samba Solar Track</h1>
<p>WLAN einrichten. Nach dem Speichern startet die Steuerung neu und verbindet sich mit deinem WLAN.</p>
<form id="f">
<label for="ssid">WLAN-Name</label>
<input type="text" id="ssid" name="ssid" maxlength="32" list="nets" autocomplete="off" required>
<datalist id="nets"></datalist>
<small id="scan">Suche nach WLANs â€¦</small>
<label for="pass">Passwort</label>
<input type="password" id="pass" name="pass" maxlength="63" autocomplete="off">
<div class="row"><input type="checkbox" id="show"><label for="show" style="margin:0;font-weight:400">Passwort anzeigen</label></div>
<div class="row"><input type="checkbox" id="open" name="open" value="1"><label for="open" style="margin:0;font-weight:400">Offenes WLAN ohne Passwort</label></div>
<label for="host">GerÃ¤tename im Netz</label>
<input type="text" id="host" name="host" maxlength="32" pattern="[a-z0-9]([a-z0-9-]*[a-z0-9])?" required>
<small>Kleinbuchstaben, Ziffern und Bindestrich</small>
<button type="submit">Speichern und neu starten</button>
<div id="msg"></div>
</form>
</main><script>
const $=id=>document.getElementById(id);
$('show').onchange=e=>{$('pass').type=e.target.checked?'text':'password'};
$('open').onchange=e=>{$('pass').disabled=e.target.checked};
let first=true;
async function load(scan){
  try{
    const r=await fetch('/setup/state'+(scan?'?scan=1':''));const s=await r.json();
    if(first){$('ssid').value=s.ssid;$('host').value=s.hostname;first=false}
    const d=$('nets');d.textContent='';
    for(const n of s.networks){const o=document.createElement('option');o.value=n.ssid;d.appendChild(o)}
    $('scan').textContent=s.scanning?'Suche nach WLANs â€¦':s.networks.length+' WLANs gefunden. Tippe in das Feld, um eines zu wÃ¤hlen.';
    if(s.scanning)setTimeout(()=>load(false),2000);
  }catch(e){setTimeout(()=>load(false),3000)}
}
load(true);
$('f').onsubmit=async e=>{
  e.preventDefault();$('msg').textContent='Speichere â€¦';
  try{
    const r=await fetch('/setup/save',{method:'POST',body:new URLSearchParams(new FormData($('f')))});
    const s=await r.json();
    $('msg').textContent=s.ok?'Gespeichert. Die Steuerung startet neu. Du kannst diese Seite schlieÃŸen.':s.detail;
  }catch(err){$('msg').textContent='Keine Antwort vom GerÃ¤t.'}
};
</script></body></html>
